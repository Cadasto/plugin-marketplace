# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Documentation site (MkDocs). Brand files are fetched by `make docs-sync`
# from Cadasto/docs-theme at the commit in sources.json. Do not commit them.
/site/
/.fetched/
/.cache/
/pages/stylesheets/tokens.css
/pages/stylesheets/material.css
/pages/stylesheets/landing.css
/overrides/home.html
/overrides/partials/copyright.html
/pages/assets/cadasto-mark.png
# scripts/sync_sources.py writes each fetched file through a `<dest>.tmp`
# sibling; a killed sync leaves one behind.
/pages/stylesheets/*.tmp
/pages/assets/*.tmp
/overrides/*.tmp
/overrides/partials/*.tmp

# Input files
input/
# Vale style packages (downloadable, not source; the vocabulary stays tracked).
# `styles/*` rather than `styles/`: git cannot re-include a path whose parent
# directory is itself excluded, so the negation below would never fire.
styles/*
!styles/config/
